// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`stripe-payment-element component tests > Rendering > should load stripe after setting the publishable-key (snapshot) 1`] = `
<stripe-payment-element class="hydrated undefined" publishable-key="pk_test_yyyy">
  <div class="stripe-payment-sheet-wrap">
    <form id="stripe-payment-element">
      <div class="stripe-heading">
        Add your payment information
      </div>
      <div>
        <div class="stripe-section-title">
          Payment information
        </div>
      </div>
      <div class="payment-info visible">
        <div id="payment-element"></div>
      </div>
      <div id="payment-errors" class="stripe-element-errors"></div>
      <div>
        <button type="submit" disabled>
          Pay
        </button>
      </div>
    </form>
  </div>
</stripe-payment-element>
`;

