{
  "name": "stripe-pwa-elements",
  "version": "4.1.3",
  "description": "Framework-agnostic Stripe Payment Elements as Web Components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/stripe-elements/stripe-elements.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build --docs && pnpm -F hono-stripe-elements run build",
    "start": "stencil build --dev --watch --serve",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm -C docs run deploy",
    "docs:dev": "pnpm -C docs run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:preview": "pnpm -C docs run preview",
    "lint": "eslint src/**/*{.ts,.tsx}",
    "fmt": "prettier-eslint --write $PWD/'src/{components, utils}/**/*{.ts,.tsx,.js}'",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test -c e2e/stripe/playwright.config.ts",
    "test:mutation": "mutator --reporter text --reporter json",
    "test:all": "vitest run",
    "test.watch": "vitest",
    "g": "stencil generate",
    "generate": "stencil generate",
    "format": "prettier --write src",
    "example:copy": "stencil build --docs && cp -R dist/stripe-elements example/",
    "example:serve": "pnpm dlx serve example",
    "prepublishOnly": "pnpm run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm run build && pnpm -F hono-stripe-elements run build && changeset publish",
    "test:e2e:stripe": "playwright test -c e2e/stripe/playwright.config.ts",
    "check:agent": "node scripts/check-deprecated-usage.mjs && node scripts/check-no-secrets.mjs && node scripts/check-stripe-service-instantiation.mjs",
    "check:example-smoke": "node scripts/check-example-smoke.mjs",
    "verify:agent": "bash scripts/verify-agent.sh"
  },
  "dependencies": {
    "@stencil/core": "^4.38.3",
    "@stripe/stripe-js": "^9.17.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "ionicons": "^8.0.13"
  },
  "keywords": [
    "stripe",
    "stripe-elements",
    "payment-element",
    "web-components",
    "web-component",
    "framework-agnostic",
    "capacitor",
    "stenciljs",
    "stencil",
    "pwa",
    "payment",
    "apple-pay",
    "google-pay",
    "checkout",
    "card-element"
  ],
  "homepage": "https://github.com/hideokamoto/stripe-pwa-elements#readme",
  "bugs": {
    "url": "https://github.com/hideokamoto/stripe-pwa-elements/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hideokamoto/stripe-pwa-elements.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "contiki9",
    "rdlabo",
    "hideokamoto"
  ],
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@mizchi/mutator": "^0.5.0",
    "@playwright/test": "1.56.1",
    "@stencil-community/eslint-plugin": "^0.10.0",
    "@stencil/sass": "^3.2.3",
    "@stencil/store": "^2.2.1",
    "@stencil/vitest": "^1.16.2",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "prettier-eslint-cli": "^8.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tmp": "^0.2.5",
      "esbuild": ">=0.28.1",
      "ws": ">=8.21.0",
      "astro": ">=7.4.7",
      "undici": ">=8.12.2",
      "js-yaml": "^4.3.2",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "svgo": ">=4.1.0",
      "immutable": ">=5.1.8",
      "smol-toml": ">=1.9.0",
      "devalue": ">=5.9.3",
      "source-map-js": ">=1.2.2",
      "dompurify": ">=3.4.17",
      "postcss-selector-parser": ">=7.1.6",
      "http-cache-semantics": ">=4.3.0",
      "brace-expansion@^1.0.0": "^1.1.21",
      "brace-expansion@^2.0.0": "^2.1.7",
      "brace-expansion@^5.0.0": "^5.0.12",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "fast-uri": "^3.1.8",
      "form-data": ">=4.0.6",
      "ip-address": ">=10.7.1",
      "minimatch@^9.0.0": "^9.0.9",
      "yaml@^2.0.0": ">=2.8.3",
      "zod@^4.0.0": ">=4.6.6"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
