{
  "name": "stripe-pwa-elements",
  "version": "4.0.1",
  "description": "Framework-agnostic Stripe Payment Elements as Web Components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/stripe-elements/stripe-elements.esm.js",
  "files": [
    "dist/",
    "hono/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build --docs && tsc -p adapters/hono/tsconfig.json",
    "start": "stencil build --dev --watch --serve",
    "typecheck": "tsc --noEmit && tsc -p adapters/hono/tsconfig.json --noEmit",
    "deploy": "pnpm -C docs run deploy",
    "docs:dev": "pnpm -C docs run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:preview": "pnpm -C docs run preview",
    "lint": "eslint src/**/*{.ts,.tsx}",
    "fmt": "prettier-eslint --write $PWD/'src/{components, utils}/**/*{.ts,.tsx,.js}'",
    "test": "stencil test --spec",
    "test:unit": "stencil test --spec --config=stencil.config.unit.ts",
    "test:component": "stencil test --spec --config=stencil.config.component.ts",
    "test:e2e": "stencil test --e2e",
    "test:all": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "g": "stencil generate",
    "generate": "stencil generate",
    "format": "prettier --write src",
    "example:copy": "stencil build --docs && cp -R dist/stripe-elements example/",
    "example:serve": "pnpm dlx serve example",
    "prepublishOnly": "pnpm run build",
    "release": "np"
  },
  "dependencies": {
    "@stencil/core": "^4.38.3",
    "@stripe/stripe-js": "^9.17.0",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "ionicons": "^8.0.13"
  },
  "keywords": [
    "stripe",
    "stripe-elements",
    "payment-element",
    "web-components",
    "web-component",
    "framework-agnostic",
    "capacitor",
    "stenciljs",
    "stencil",
    "pwa",
    "payment",
    "apple-pay",
    "google-pay",
    "checkout",
    "card-element"
  ],
  "homepage": "https://github.com/hideokamoto/stripe-pwa-elements#readme",
  "bugs": {
    "url": "https://github.com/hideokamoto/stripe-pwa-elements/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hideokamoto/stripe-pwa-elements.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "contiki9",
    "rdlabo",
    "hideokamoto"
  ],
  "author": {
    "name": "Hidetaka Okamoto",
    "url": "https://github.com/hideokamoto"
  },
  "license": "MIT",
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@jsr/circleci__jest-circleci-coverage": "^0.4.0",
    "@stencil-community/eslint-plugin": "^0.10.0",
    "@stencil/sass": "^3.2.3",
    "@stencil/store": "^2.2.1",
    "@types/jest": "^29.5.14",
    "@types/puppeteer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "hono": "^4.13.13",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-junit": "^17.0.0",
    "np": "^10.2.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "prettier-eslint-cli": "^8.0.1",
    "puppeteer": "^24.30.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "tmp": "^0.2.5",
      "esbuild": ">=0.28.1",
      "ws": ">=8.21.0",
      "astro": ">=7.3.8",
      "undici": ">=7.29.1",
      "js-yaml": "^4.3.2",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "svgo": ">=4.1.0",
      "immutable": ">=5.1.8",
      "smol-toml": ">=1.9.0",
      "devalue": ">=5.9.3",
      "source-map-js": ">=1.2.2",
      "dompurify": ">=3.4.13",
      "postcss-selector-parser": ">=7.1.6",
      "http-cache-semantics": ">=4.3.0",
      "brace-expansion@^1.0.0": "^1.1.21",
      "brace-expansion@^2.0.0": "^2.1.7",
      "brace-expansion@^5.0.0": "^5.0.12",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "fast-uri": "^3.1.8",
      "form-data": ">=4.0.6",
      "ip-address": ">=10.7.1",
      "minimatch@^9.0.0": "^9.0.9",
      "yaml@^2.0.0": ">=2.8.3"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
